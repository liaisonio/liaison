# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
*.local.env
*.pem
*.p12
*.pfx

# binary
bin/
logs/

# Editor/IDE
# .idea/
# .vscode/
.DS_Store
.deploy-liaison.sh

# Frontend dependencies
web/node_modules/
web/.umi/
web/dist/
web/build/
web/.cache/

# TLS certificates (keep private keys out of git)
certs/*.key
certs/*.crt
!certs/README.md
!certs/generate_certs.sh

# Build artifacts
/liaison-v*.tar.gz
/liaison-[0-9]*-linux-*.tar.gz
/liaison-[0-9]*-docker-*.tar.gz
/liaison-[0-9]*-docker-*/
/packages/
/bin/
/web/dist/

# Docker compose runtime state
/deploy/docker/.env
/deploy/docker/data/
/deploy/docker/certs/
/deploy/docker/logs/

# Local runtime state
/local-run/
.gstack/

# Local design documents and visual assets
/design/
/docs/adr/
/docs/design/
/website/
/output/
/liaison-*.png

# Local agent and skill configuration
/.agents/
/.agent/
/.playwright-mcp/
/.mini-wiki/

# Private design, implementation notes and environment acceptance evidence
/docs/architecture/
/docs/ops/
/docs/biz_sequence.md
/docs/native-llm-protocols.md
/docs/branch-reconciliation.md
/docs/verification-20260918.md
